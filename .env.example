# Canonical public address. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ofertastudio.pl
# Keep previews and concept imagery out of search results.
NEXT_PUBLIC_INDEXABLE=false
# Supply a verified real business address when available.
NEXT_PUBLIC_CONTACT_EMAIL=
# Enable only on Netlify after form detection + business/privacy information are ready.
CONTACT_FORM_ENABLED=false
# Synthetic submissions only, allowed outside the production deploy context.
CONTACT_FORM_TEST_MODE=false
# Live enquiries additionally require an approved notice in src/content/privacy.ts.
# NETLIFY=true is set by the hosting platform; do not set it for ordinary local preview.
